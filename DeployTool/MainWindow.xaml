<Window x:Class="DeployTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DeployTool"
        xmlns:vm="clr-namespace:DeployTool.ViewModels"
        xmlns:conv="clr-namespace:DeployTool.Converters"
        mc:Ignorable="d"
        Title="PC Voorinstallatie" Height="780" Width="960" MinHeight="600" MinWidth="760"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <conv:ItemStatusToIconConverter x:Key="StatusToIcon"/>
        <conv:ItemStatusToLabelConverter x:Key="StatusToLabel"/>
        <conv:ItemStatusToPillForegroundConverter x:Key="StatusToPillForeground"/>
        <conv:ItemStatusToPillBackgroundConverter x:Key="StatusToPillBackground"/>
        <conv:ItemStatusToPillVisibilityConverter x:Key="StatusToPillVisibility"/>
        <conv:ItemStatusToRetryVisibilityConverter x:Key="StatusToRetryVisibility"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility"/>
        <conv:BoolToStarConverter x:Key="BoolToStar"/>
        <conv:BoolToAccentForegroundConverter x:Key="BoolToAccentForeground"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <Style x:Key="RowBorder" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="2,8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PillBorder" TargetType="Border">
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <DataTemplate x:Key="ItemRowTemplate" DataType="{x:Type vm:SessionItemViewModel}">
            <Border Style="{StaticResource RowBorder}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <CheckBox Grid.Column="0" VerticalAlignment="Center" Margin="4,0,10,0"
                              IsChecked="{Binding IsSelected}" IsEnabled="{Binding IsConfigured}"/>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontSize="13.5"/>
                        <Border Style="{StaticResource PillBorder}" Background="{StaticResource RunningSoftBrush}"
                                HorizontalAlignment="Left" Margin="0,3,0,0" Padding="8,2"
                                Visibility="{Binding IsConfigured, Converter={StaticResource InverseBoolToVisibility}}">
                            <TextBlock Text="Nog te configureren" FontSize="10.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource RunningBrush}"/>
                        </Border>
                    </StackPanel>

                    <Button Grid.Column="2" Content="{Binding ConfigureButtonLabel}" Style="{StaticResource GhostButton}" Margin="6,0"
                            Visibility="{Binding IsInstaller, Converter={StaticResource BoolToVisibility}}"
                            Command="{Binding DataContext.ConfigureCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}"/>

                    <Button Grid.Column="2" Style="{StaticResource GhostButton}" Margin="6,0" Padding="8,5"
                            Visibility="{Binding CanToggleDefault, Converter={StaticResource BoolToVisibility}}"
                            ToolTip="Standaard aangevinkt bij een nieuwe sessie"
                            Command="{Binding DataContext.ToggleDefaultCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding IsDefault, Converter={StaticResource BoolToStar}}"
                                       Foreground="{Binding IsDefault, Converter={StaticResource BoolToAccentForeground}}"
                                       FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock Text="Standaard" FontSize="12" Margin="5,0,0,0" VerticalAlignment="Center"
                                       Foreground="{Binding IsDefault, Converter={StaticResource BoolToAccentForeground}}"/>
                        </StackPanel>
                    </Button>

                    <Border Grid.Column="3" Style="{StaticResource PillBorder}" Margin="8,0"
                            Background="{Binding Status, Converter={StaticResource StatusToPillBackground}}"
                            Visibility="{Binding Status, Converter={StaticResource StatusToPillVisibility}}"
                            ToolTip="{Binding ErrorMessage}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Status, Converter={StaticResource StatusToIcon}}"
                                       Foreground="{Binding Status, Converter={StaticResource StatusToPillForeground}}"
                                       FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Status, Converter={StaticResource StatusToLabel}}"
                                       Foreground="{Binding Status, Converter={StaticResource StatusToPillForeground}}"
                                       FontSize="11" FontWeight="SemiBold" Margin="5,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Button Grid.Column="4" Content="Opnieuw proberen" Style="{StaticResource GhostButton}"
                            Visibility="{Binding Status, Converter={StaticResource StatusToRetryVisibility}}"
                            Command="{Binding DataContext.RetryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}"/>
                </Grid>
            </Border>
        </DataTemplate>

        <Style x:Key="SectionCard" TargetType="Border" BasedOn="{StaticResource CardBorder}">
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Padding" Value="16"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="210"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1" Padding="24,12">
            <StackPanel Orientation="Horizontal">
                <Border Width="32" Height="32" CornerRadius="9" Background="{StaticResource AccentBrush}">
                    <TextBlock Text="PC" Foreground="White" FontWeight="Bold" FontSize="12"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="PC Voorinstallatie" FontSize="15.5" FontWeight="SemiBold"/>
                    <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="11.5" Margin="0,1,0,0">
                        <Run Text="Voorbereiden van"/>
                        <Run Text="{Binding MachineName, Mode=OneWay}" FontWeight="SemiBold"/>
                    </TextBlock>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Loading state -->
        <Grid Grid.Row="1" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="{Binding StatusMessage}" FontSize="15" Foreground="{StaticResource TextSecondaryBrush}"/>
            </StackPanel>
        </Grid>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0"
                      Visibility="{Binding IsLoading, Converter={StaticResource InverseBoolToVisibility}}">
            <StackPanel Margin="24,16,24,4">

                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,4">
                            <TextBlock Text="Software" Style="{StaticResource SectionHeaderText}"/>
                            <TextBlock Text="{Binding Installers.Count, StringFormat={}{0} item(en)}" Style="{StaticResource SectionCountText}"/>
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding Installers}" ItemTemplate="{StaticResource ItemRowTemplate}"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,4">
                            <TextBlock Text="Snelkoppelingen" Style="{StaticResource SectionHeaderText}"/>
                            <TextBlock Text="{Binding Shortcuts.Count, StringFormat={}{0} item(en)}" Style="{StaticResource SectionCountText}"/>
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding Shortcuts}" ItemTemplate="{StaticResource ItemRowTemplate}"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,4">
                            <TextBlock Text="Instellingen" Style="{StaticResource SectionHeaderText}"/>
                            <TextBlock Text="{Binding Settings.Count, StringFormat={}{0} item(en)}" Style="{StaticResource SectionCountText}"/>
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding Settings}" ItemTemplate="{StaticResource ItemRowTemplate}"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,4">
                            <TextBlock Text="Bloatware" Style="{StaticResource SectionHeaderText}"/>
                            <TextBlock Text="{Binding Bloatware.Count, StringFormat={}{0} item(en)}" Style="{StaticResource SectionCountText}"/>
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding Bloatware}" ItemTemplate="{StaticResource ItemRowTemplate}"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Live log -->
        <Border Grid.Row="2" Background="{StaticResource TerminalBackgroundBrush}" Margin="24,0,24,12" CornerRadius="12" Padding="0">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="16,10,16,6">
                    <TextBlock Text="LIVE LOGGING" Foreground="{StaticResource TerminalMutedBrush}" FontSize="11" FontWeight="Bold"/>
                </DockPanel>
                <ListBox x:Name="LogListBox" ItemsSource="{Binding LogLines}" DockPanel.Dock="Bottom"
                         Background="Transparent" BorderThickness="0" Padding="16,0,16,12"
                         FontFamily="{StaticResource MonoFontFamily}" FontSize="11.5" Foreground="{StaticResource TerminalTextBrush}"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0,1"/>
                            <Setter Property="MinHeight" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter Margin="{TemplateBinding Padding}"/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Footer -->
        <Border Grid.Row="3" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0" Padding="24,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
                <Button Grid.Column="1" Content="Start installatie" Style="{StaticResource PrimaryButton}"
                        Command="{Binding StartCommand}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
