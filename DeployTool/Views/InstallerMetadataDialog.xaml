<Window x:Class="DeployTool.Views.InstallerMetadataDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Installer configureren"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding FileName}" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,12"/>

        <TextBlock Grid.Row="1" Text="Weergavenaam"/>
        <TextBox Grid.Row="2" Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12"/>

        <TextBlock Grid.Row="3" Text="Silent-install switch (bv. /S, /silent, /qn)"/>
        <TextBox Grid.Row="4" Text="{Binding SilentArgs, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12"/>

        <TextBlock Grid.Row="5" Text="Categorie (optioneel)"/>
        <TextBox Grid.Row="6" Text="{Binding Category, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12"/>

        <CheckBox Grid.Row="7" Content="Standaard geselecteerd" IsChecked="{Binding DefaultSelected}" Margin="0,0,0,4"/>

        <StackPanel Grid.Row="10" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Annuleren" Width="90" Margin="0,0,8,0" Click="Cancel_Click" IsCancel="True"/>
            <Button Content="Opslaan" Width="90" Click="Save_Click" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
