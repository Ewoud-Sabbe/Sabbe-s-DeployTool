<Window x:Class="DeployTool.Views.InstallerMetadataDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Installer configureren"
        Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <StackPanel Margin="28,24,28,24">

        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
            <Border Width="34" Height="34" CornerRadius="9" Background="{StaticResource AccentBrush}">
                <TextBlock Text="⚙" Foreground="White" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Installer configureren" FontSize="15" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding FileName}" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}"
                           TextWrapping="Wrap" MaxWidth="330" Margin="0,1,0,0"/>
            </StackPanel>
        </StackPanel>

        <TextBlock Text="WEERGAVENAAM" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextTertiaryBrush}" Margin="0,0,0,6"/>
        <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16"/>

        <TextBlock Text="SILENT-INSTALL SWITCH" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextTertiaryBrush}" Margin="0,0,0,6"/>
        <TextBox Text="{Binding SilentArgs, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4"/>
        <TextBlock Text="bijvoorbeeld /S, /silent of /qn" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" Margin="0,0,0,16"/>

        <TextBlock Text="CATEGORIE (OPTIONEEL)" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextTertiaryBrush}" Margin="0,0,0,6"/>
        <TextBox Text="{Binding Category, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,18"/>

        <CheckBox Content="Standaard geselecteerd" IsChecked="{Binding DefaultSelected}" Margin="0,0,0,24"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Annuleren" Width="100" Margin="0,0,8,0" Click="Cancel_Click" IsCancel="True"/>
            <Button Content="Opslaan" Width="100" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center" Click="Save_Click" IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</Window>
